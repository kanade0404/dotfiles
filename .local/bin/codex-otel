#!/usr/bin/env bash
# Refresh Codex's user-level OpenTelemetry config from non-committed
# credentials, then launch Codex. The generated config is mode 600.
set -u

codex_home="${CODEX_HOME:-$HOME/.codex}"
config_target="${CODEX_OTEL_CONFIG_TARGET:-$codex_home/config.toml}"
mode="launch"

if [ "${1:-}" = "--write-config-only" ]; then
  mode="write-config"
  shift
fi

otel_environment="${CODEX_OTEL_ENVIRONMENT:-dev}"
logs_endpoint="${CODEX_OTEL_LOGS_ENDPOINT:-https://otel-collector-vr35tgknva-an.a.run.app/v1/logs}"
metrics_endpoint="${CODEX_OTEL_METRICS_ENDPOINT:-https://otel-collector-vr35tgknva-an.a.run.app/v1/metrics}"
traces_endpoint="${CODEX_OTEL_TRACES_ENDPOINT:-https://otel-collector-vr35tgknva-an.a.run.app/v1/traces}"

token="${OTEL_EXPORTER_TOKEN:-}"

trim_spaces() {
  local value="$1"
  while :; do
    case "$value" in
      [[:space:]]*) value="${value#?}" ;;
      *[[:space:]]) value="${value%?}" ;;
      *) break ;;
    esac
  done
  printf '%s' "$value"
}

toml_escape() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  printf '%s' "$value"
}

find_keychain_token() {
  local service="$1"
  local account="${USER:-$(id -un 2>/dev/null)}"
  security find-generic-password -s "$service" -a "$account" -w 2>/dev/null
}

cleanup_tmp_config() {
  if [ -n "${tmp_config:-}" ]; then
    rm -f "$tmp_config"
  fi
}

print_otlp_http_exporter() {
  local table="$1"
  local endpoint="$2"

  printf '\n[%s]\n' "$table"
  printf 'endpoint = "%s"\n' "$(toml_escape "$endpoint")"
  printf 'protocol = "json"\n'
  if [ -n "$token" ]; then
    printf '\n[%s.headers]\n' "$table"
    printf 'Authorization = "Bearer %s"\n' "$(toml_escape "$token")"
  fi
}

write_otel_tables() {
  printf '[otel]\n'
  printf 'environment = "%s"\n' "$(toml_escape "$otel_environment")"
  printf 'log_user_prompt = false\n'

  print_otlp_http_exporter 'otel.exporter."otlp-http"' "$logs_endpoint"
  print_otlp_http_exporter 'otel.metrics_exporter."otlp-http"' "$metrics_endpoint"
  print_otlp_http_exporter 'otel.trace_exporter."otlp-http"' "$traces_endpoint"
}

write_managed_config() {
  local target="$1"
  local target_dir
  local tmp_config=""
  local begin_marker="# BEGIN CODEX OTEL MANAGED"
  local end_marker="# END CODEX OTEL MANAGED"
  local filter_status
  local has_unmanaged_content=0

  target_dir="$(dirname "$target")"
  mkdir -p "$target_dir" || return 1
  tmp_config="$(mktemp "$target_dir/.codex-config.XXXXXX")" || return 1
  trap cleanup_tmp_config EXIT HUP INT TERM
  chmod 600 "$tmp_config" 2>/dev/null || true

  if [ -f "$target" ]; then
    awk -v begin="$begin_marker" -v end="$end_marker" '
      function trim(value) {
        sub(/^[[:space:]]+/, "", value)
        sub(/[[:space:]]+$/, "", value)
        return value
      }
      function is_otel_table_header(value, inner) {
        value = trim(value)
        if (value !~ /^\[/) { return 0 }
        inner = value
        sub(/^\[/, "", inner)
        sub(/\].*$/, "", inner)
        gsub(/[[:space:]]+/, "", inner)
        return inner == "otel" || inner ~ /^otel[.]/ || inner == "\"otel\"" || inner ~ /^"otel"[.]/
      }
      {
        line = trim($0)
        if (line == begin) { skip = 1; next }
        if (line == end) { skip = 0; next }
        if (skip) { next }
        if (is_otel_table_header(line)) {
          unmanaged_otel = 1
          next
        }
        if ($0 ~ /^[[:space:]]*$/) {
          blanks = blanks $0 ORS
          next
        }
        printf "%s", blanks
        blanks = ""
        print
      }
      END {
        if (unmanaged_otel) { exit 42 }
      }
    ' "$target" >"$tmp_config"
    filter_status=$?
    if [ "$filter_status" -ne 0 ]; then
      if [ "$filter_status" -eq 42 ]; then
        echo "codex-otel: unmanaged [otel] config already exists in $target; remove or migrate it before writing the managed block" >&2
      fi
      cleanup_tmp_config
      trap - EXIT HUP INT TERM
      return 1
    fi
  fi

  if [ -s "$tmp_config" ]; then
    has_unmanaged_content=1
  fi

  {
    if [ "$has_unmanaged_content" -eq 1 ]; then
      printf '\n\n%s\n' "$begin_marker"
    else
      printf '%s\n' "$begin_marker"
    fi
    write_otel_tables
    printf '\n%s\n' "$end_marker"
  } >>"$tmp_config" || {
    cleanup_tmp_config
    trap - EXIT HUP INT TERM
    return 1
  }

  mv "$tmp_config" "$target" || {
    cleanup_tmp_config
    trap - EXIT HUP INT TERM
    return 1
  }
  tmp_config=""
  trap - EXIT HUP INT TERM
  chmod 600 "$target" 2>/dev/null || true
}

token="$(trim_spaces "$token")"

if [ -z "$token" ] && [ "$(uname -s)" = "Darwin" ]; then
  token="$(find_keychain_token "codex-otel")"
  token="$(trim_spaces "$token")"
fi

if [ -z "$token" ] && [ "$(uname -s)" = "Darwin" ]; then
  token="$(find_keychain_token "claude-code-otel")"
  token="$(trim_spaces "$token")"
fi

case "$token" in
  *[[:cntrl:]]*)
    echo "codex-otel: token contains control characters; generating config without Authorization header" >&2
    token=""
    ;;
esac

if [ "$mode" = "launch" ] && ! mkdir -p "$codex_home"; then
  echo "codex-otel: failed to create $codex_home; launching codex without refreshing telemetry" >&2
fi

if ! write_managed_config "$config_target"; then
  if [ "$mode" = "write-config" ]; then
    exit 1
  fi
  echo "codex-otel: failed to refresh OTEL config; launching codex without refreshing telemetry" >&2
fi

if [ -z "$token" ]; then
  echo "codex-otel: no token; set OTEL_EXPORTER_TOKEN or add Keychain item 'codex-otel' / 'claude-code-otel'" >&2
fi

if [ "$mode" = "write-config" ]; then
  exit 0
fi

exec codex "$@"
