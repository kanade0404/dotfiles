#!/usr/bin/env bash
# Refresh Codex's user-level OpenTelemetry config from non-committed
# credentials, then launch Codex. The generated config is mode 600.
set -u

codex_home="${CODEX_HOME:-$HOME/.codex}"
config_target="${CODEX_OTEL_CONFIG_TARGET:-$codex_home/config.toml}"
mode="launch"

if [ "${1:-}" = "--write-config-only" ]; then
  mode="write-config"
  shift
fi

default_otel_environment="dev"
# Keep these Collector endpoints in sync with .claude/settings.json.
default_logs_endpoint="https://otel-collector-vr35tgknva-an.a.run.app/v1/logs"
default_metrics_endpoint="https://otel-collector-vr35tgknva-an.a.run.app/v1/metrics"
default_traces_endpoint="https://otel-collector-vr35tgknva-an.a.run.app/v1/traces"
otel_environment="${CODEX_OTEL_ENVIRONMENT:-$default_otel_environment}"
logs_endpoint="${CODEX_OTEL_LOGS_ENDPOINT:-$default_logs_endpoint}"
metrics_endpoint="${CODEX_OTEL_METRICS_ENDPOINT:-$default_metrics_endpoint}"
traces_endpoint="${CODEX_OTEL_TRACES_ENDPOINT:-$default_traces_endpoint}"

token="${OTEL_EXPORTER_TOKEN:-}"
preserve_auth_from="${CODEX_OTEL_PRESERVE_AUTH_FROM:-}"

trim_spaces() {
  local value="$1"
  while :; do
    case "$value" in
      [[:space:]]*) value="${value#?}" ;;
      *[[:space:]]) value="${value%?}" ;;
      *) break ;;
    esac
  done
  printf '%s' "$value"
}

toml_escape() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  printf '%s' "$value"
}

find_keychain_token() {
  local service="$1"
  local account="${USER:-$(id -un 2>/dev/null)}"
  security find-generic-password -s "$service" -a "$account" -w 2>/dev/null
}

cleanup_tmp_config() {
  if [ -n "${tmp_config:-}" ]; then
    rm -f "$tmp_config"
  fi
}

clear_tmp_config_traps() {
  trap - EXIT HUP INT TERM
}

install_tmp_config_traps() {
  trap cleanup_tmp_config EXIT
  trap 'cleanup_tmp_config; trap - HUP; exit 129' HUP
  trap 'cleanup_tmp_config; trap - INT; exit 130' INT
  trap 'cleanup_tmp_config; trap - TERM; exit 143' TERM
}

sanitize_config_value() {
  local name="$1"
  local value="$2"
  local default_value="$3"

  case "$value" in
    *[[:cntrl:]]*)
      echo "codex-otel: $name contains control characters; using default value" >&2
      printf '%s' "$default_value"
      ;;
    *)
      printf '%s' "$value"
      ;;
  esac
}

print_otlp_http_exporter() {
  local table="$1"
  local endpoint="$2"

  printf '\n[%s]\n' "$table"
  printf 'endpoint = "%s"\n' "$(toml_escape "$endpoint")"
  printf 'protocol = "json"\n'
  if [ -n "$token" ]; then
    printf '\n[%s.headers]\n' "$table"
    printf 'Authorization = "Bearer %s"\n' "$(toml_escape "$token")"
  fi
}

write_otel_tables() {
  printf '[otel]\n'
  printf 'environment = "%s"\n' "$(toml_escape "$otel_environment")"
  printf 'log_user_prompt = false\n'

  print_otlp_http_exporter 'otel.exporter."otlp-http"' "$logs_endpoint"
  print_otlp_http_exporter 'otel.metrics_exporter."otlp-http"' "$metrics_endpoint"
  print_otlp_http_exporter 'otel.trace_exporter."otlp-http"' "$traces_endpoint"
}

managed_block_has_authorization() {
  managed_block_authorization_token "$1" >/dev/null
}

managed_block_authorization_token() {
  local target="$1"
  local begin_marker="# BEGIN CODEX OTEL MANAGED"
  local end_marker="# END CODEX OTEL MANAGED"

  [ -f "$target" ] || return 1

  # Keep marker parsing in sync with write_managed_config's filter below.
  awk -v begin="$begin_marker" -v end="$end_marker" '
    function trim(value) {
      sub(/^[[:space:]]+/, "", value)
      sub(/[[:space:]]+$/, "", value)
      return value
    }
    function print_authorization_token(value, i, ch, next_ch, rest, token) {
      value = trim(value)
      if (value !~ /^Authorization[[:space:]]*=[[:space:]]*"Bearer /) {
        return 0
      }
      sub(/^Authorization[[:space:]]*=[[:space:]]*"Bearer /, "", value)
      token = ""
      for (i = 1; i <= length(value); i++) {
        ch = substr(value, i, 1)
        if (ch == "\\") {
          if (i == length(value)) { return 0 }
          i++
          next_ch = substr(value, i, 1)
          if (next_ch == "\\" || next_ch == "\"") {
            token = token next_ch
          } else {
            token = token "\\" next_ch
          }
          continue
        }
        if (ch == "\"") {
          rest = trim(substr(value, i + 1))
          if (rest != "") { return 0 }
          print token
          return 1
        }
        token = token ch
      }
      return 0
    }
    {
      line = $0
      sub(/^[[:space:]]+/, "", line)
      sub(/[[:space:]]+$/, "", line)
      if (line == begin) {
        if (in_managed) { malformed_managed = 1 }
        in_managed = 1
        next
      }
      if (line == end) {
        if (!in_managed) { malformed_managed = 1 }
        in_managed = 0
        next
      }
      if (!found && in_managed && line ~ /^Authorization[[:space:]]*=/) {
        found = print_authorization_token(line)
      }
    }
    END {
      if (in_managed || malformed_managed) { exit 2 }
      exit found ? 0 : 1
    }
  ' "$target"
}

write_managed_config() {
  local target="$1"
  local target_dir
  local tmp_config=""
  local begin_marker="# BEGIN CODEX OTEL MANAGED"
  local end_marker="# END CODEX OTEL MANAGED"
  local filter_status
  local has_unmanaged_content=0

  target_dir="$(dirname "$target")"
  mkdir -p "$target_dir" || {
    echo "codex-otel: failed to create config directory $target_dir" >&2
    return 1
  }
  tmp_config="$(mktemp "$target_dir/.codex-config.XXXXXX")" || {
    echo "codex-otel: failed to create temporary config in $target_dir" >&2
    return 1
  }
  install_tmp_config_traps
  chmod 600 "$tmp_config" 2>/dev/null || true

  if [ -f "$target" ]; then
    # Keep marker parsing in sync with managed_block_authorization_token above.
    awk -v begin="$begin_marker" -v end="$end_marker" '
      function trim(value) {
        sub(/^[[:space:]]+/, "", value)
        sub(/[[:space:]]+$/, "", value)
        return value
      }
      function is_otel_header_inner(inner, i, ch, quote, key, rest) {
        inner = trim(inner)
        if (inner == "") { return 0 }
        quote = substr(inner, 1, 1)
        if (quote == "\"" || quote == "'\''") {
          for (i = 2; i <= length(inner); i++) {
            ch = substr(inner, i, 1)
            if (ch == quote && substr(inner, i - 1, 1) != "\\") {
              key = substr(inner, 2, i - 2)
              rest = trim(substr(inner, i + 1))
              return key == "otel" && (rest == "" || rest ~ /^[.]/)
            }
          }
          return 0
        }
        for (i = 1; i <= length(inner); i++) {
          ch = substr(inner, i, 1)
          if (ch ~ /[[:space:].]/) { break }
        }
        key = substr(inner, 1, i - 1)
        rest = trim(substr(inner, i))
        return key == "otel" && (rest == "" || rest ~ /^[.]/)
      }
      function is_otel_table_header(value, inner) {
        value = trim(value)
        if (value !~ /^\[/) { return 0 }
        inner = value
        if (inner ~ /^\[\[/) {
          sub(/^\[\[[[:space:]]*/, "", inner)
          sub(/[[:space:]]*\]\].*$/, "", inner)
        } else {
          sub(/^\[[[:space:]]*/, "", inner)
          sub(/[[:space:]]*\].*$/, "", inner)
        }
        return is_otel_header_inner(inner)
      }
      function is_otel_top_level_key(value) {
        value = trim(value)
        if (value == "" || value ~ /^#|^\[/) { return 0 }
        return value ~ /^otel[[:space:]]*([.=])/ ||
          value ~ /^"otel"[[:space:]]*([.=])/ ||
          value ~ /^'\''otel'\''[[:space:]]*([.=])/
      }
      function strip_comment(value, i, ch, quote, escaped) {
        quote = ""
        escaped = 0
        for (i = 1; i <= length(value); i++) {
          ch = substr(value, i, 1)
          if (quote == "") {
            if (ch == "#") { return substr(value, 1, i - 1) }
            if (ch == "\"" || ch == "'\''") {
              quote = ch
              escaped = 0
            }
            continue
          }
          if (quote == "\"") {
            if (escaped) {
              escaped = 0
            } else if (ch == "\\") {
              escaped = 1
            } else if (ch == quote) {
              quote = ""
            }
          } else if (ch == quote) {
            quote = ""
          }
        }
        return value
      }
      function update_multiline_state(value, basic_pos, literal_pos, pos, delimiter, rest) {
        rest = value
        while (1) {
          basic_pos = index(rest, "\"\"\"")
          literal_pos = index(rest, "'\'''\'''\''")
          if (!basic_pos && !literal_pos) { return }
          if (basic_pos && (!literal_pos || basic_pos < literal_pos)) {
            pos = basic_pos
            delimiter = "\"\"\""
          } else {
            pos = literal_pos
            delimiter = "'\'''\'''\''"
          }
          if (multiline_delimiter == "") {
            multiline_delimiter = delimiter
          } else if (multiline_delimiter == delimiter) {
            multiline_delimiter = ""
          }
          rest = substr(rest, pos + 3)
        }
      }
      {
        was_in_multiline = multiline_delimiter != ""
        line = trim($0)
        if (was_in_multiline) {
          update_multiline_state($0)
          printf "%s", blanks
          blanks = ""
          print
          next
        }
        if (line == begin) {
          if (skip) { malformed_managed = 1 }
          skip = 1
          next
        }
        if (line == end) {
          if (!skip) { malformed_managed = 1 }
          skip = 0
          next
        }
        if (skip) { next }
        update_multiline_state(strip_comment($0))
        if (line ~ /^\[/) { in_table = 1 }
        if (is_otel_table_header(line)) {
          unmanaged_otel = 1
          next
        }
        if (!in_table && is_otel_top_level_key(line)) {
          unmanaged_otel = 1
          next
        }
        if ($0 ~ /^[[:space:]]*$/) {
          blanks = blanks $0 ORS
          next
        }
        printf "%s", blanks
        blanks = ""
        print
      }
      END {
        if (skip || malformed_managed) { exit 43 }
        if (unmanaged_otel) { exit 42 }
      }
    ' "$target" >"$tmp_config"
    filter_status=$?
    if [ "$filter_status" -ne 0 ]; then
      if [ "$filter_status" -eq 42 ]; then
        echo "codex-otel: unmanaged [otel] config already exists in $target; remove or migrate it before writing the managed block. If Codex reserialized the file and dropped managed markers, remove the existing [otel] table and re-run install.sh." >&2
      elif [ "$filter_status" -eq 43 ]; then
        echo "codex-otel: managed OTEL block markers in $target are unbalanced; refusing to rewrite" >&2
      else
        echo "codex-otel: failed to filter existing config $target (awk exit $filter_status)" >&2
      fi
      cleanup_tmp_config
      clear_tmp_config_traps
      return 1
    fi
  fi

  if [ -s "$tmp_config" ]; then
    has_unmanaged_content=1
  fi

  {
    if [ "$has_unmanaged_content" -eq 1 ]; then
      printf '\n\n%s\n' "$begin_marker"
    else
      printf '%s\n' "$begin_marker"
    fi
    write_otel_tables
    printf '\n%s\n' "$end_marker"
  } >>"$tmp_config" || {
    echo "codex-otel: failed to append managed OTEL block for $target" >&2
    cleanup_tmp_config
    clear_tmp_config_traps
    return 1
  }

  mv "$tmp_config" "$target" || {
    echo "codex-otel: failed to replace $target with refreshed OTEL config" >&2
    cleanup_tmp_config
    clear_tmp_config_traps
    return 1
  }
  tmp_config=""
  clear_tmp_config_traps
  chmod 600 "$target" 2>/dev/null || true
}

otel_environment="$(sanitize_config_value CODEX_OTEL_ENVIRONMENT "$otel_environment" "$default_otel_environment")"
logs_endpoint="$(sanitize_config_value CODEX_OTEL_LOGS_ENDPOINT "$logs_endpoint" "$default_logs_endpoint")"
metrics_endpoint="$(sanitize_config_value CODEX_OTEL_METRICS_ENDPOINT "$metrics_endpoint" "$default_metrics_endpoint")"
traces_endpoint="$(sanitize_config_value CODEX_OTEL_TRACES_ENDPOINT "$traces_endpoint" "$default_traces_endpoint")"

token="$(trim_spaces "$token")"
os="$(uname -s)"

if [ -z "$token" ] && [ "$os" = "Darwin" ]; then
  for service in codex-otel claude-code-otel; do
    token="$(find_keychain_token "$service")"
    token="$(trim_spaces "$token")"
    [ -n "$token" ] && break
  done
fi

case "$token" in
  *[[:cntrl:]]*)
    echo "codex-otel: token contains control characters; generating config without Authorization header" >&2
    token=""
    ;;
esac

if [ -z "$token" ] && managed_block_has_authorization "$config_target"; then
  echo "codex-otel: no token; preserving existing Authorization header in $config_target" >&2
else
  if [ -z "$token" ] && [ -n "$preserve_auth_from" ]; then
    preserved_token="$(managed_block_authorization_token "$preserve_auth_from")"
    preserve_status=$?
    if [ "$preserve_status" -eq 0 ]; then
      token="$(trim_spaces "$preserved_token")"
    elif [ "$preserve_status" -eq 2 ]; then
      echo "codex-otel: managed OTEL block markers in $preserve_auth_from are unbalanced; refusing to preserve Authorization" >&2
      if [ "$mode" = "write-config" ]; then
        exit 1
      fi
    fi
  fi
  if ! write_managed_config "$config_target"; then
    if [ "$mode" = "write-config" ]; then
      exit 1
    fi
    echo "codex-otel: failed to refresh OTEL config; launching codex without refreshing telemetry" >&2
  fi
fi

if [ -z "$token" ]; then
  echo "codex-otel: no token; set OTEL_EXPORTER_TOKEN or add Keychain item 'codex-otel' / 'claude-code-otel'" >&2
fi

if [ "$mode" = "write-config" ]; then
  exit 0
fi

exec codex "$@"
